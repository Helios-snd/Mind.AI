# Copy to .env and fill in. Never commit .env.

# PostgreSQL. The local install is EDB PostgreSQL 18 on :5432.
#   createdb -h localhost -U postgres mindai
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/mindai

# Signing key for session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGEME

# Cookie behaviour. SECURE=false is correct for http://localhost only.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Token lifetimes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# One-time login codes
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# In dev, OTPs are written to the log instead of sent. Never enable in production.
LOGIN_CODE_ECHO=true

# Consent policy version stamped onto consent_events
POLICY_VERSION=2026-09-01

# Model runtime, via one OpenAI-compatible provider (app/agents/provider).
#   local (macOS), self-hosted: http://localhost:11434/v1   (Ollama)
#   production, self-hosted:    http://vllm:8000/v1         (vLLM)
#   hosted (needs LLM_API_KEY): https://api.groq.com/openai/v1   (Groq)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Bearer token for a hosted provider. Leave blank for Ollama/vLLM.
LLM_API_KEY=

# Self-hosted speech-to-text. Not used until the Talk slice.
STT_BASE_URL=

ENV=dev
LOG_LEVEL=INFO
